# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000

# Either DATABASE_URL (Neon / Render) ...
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# ... or the individual settings for local Postgres:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=snapseat
DB_USER=postgres
DB_PASSWORD=change-me
# DB_SSL=true

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=24h
# Shared secret the (fake) payment gateway uses to sign webhooks. Generate the same way.
WEBHOOK_SECRET=replace-with-another-long-random-string

# Comma-separated list of web origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# Only for a demo deployment: lets the DEV "simulate failure" switch work in production.
# ALLOW_TEST_PAYMENT_HOOKS=false
